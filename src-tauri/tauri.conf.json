{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Readtis",
  "version": "0.1.0",
  "identifier": "com.motionphrey.readtis",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Readtis",
        "width": 480,
        "height": 620,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Motionphrey",
    "icon": [
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 Motionphrey",
    "category": "Productivity",
    "shortDescription": "Read highlighted text aloud with natural Edge TTS voices.",
    "longDescription": "Readtis is a Windows tray app that reads highlighted text aloud with natural Edge TTS voices."
  }
}
